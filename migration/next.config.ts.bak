/**
 * next.config.ts — Next.js 15 最小クリーン構成
 *
 * ⚠️ やってはいけないこと（MIMEエラー・RSC崩壊の原因になる）:
 *   1. import.meta.url / fileURLToPath をここで使う
 *      → Next.js は next.config.ts を CJS ライクに transpile するため
 *        import.meta.url が undefined になり throw → Dev Server が起動不能
 *        → 全リクエストに text/html のエラー HTML が返る（MIMEエラーの根本原因）
 *   2. outputFileTracingRoot を __dirname 計算で設定する
 *      → 同上。Vercel 本番で必要な場合は process.cwd() を使う
 *   3. webpack({ cache: ... }) / splitChunks のカスタム
 *      → RSC ペイロードの整合性が破綻する
 */

import type { NextConfig } from 'next';

const nextConfig: NextConfig = {
  // React StrictMode（副作用バグを早期発見）
  reactStrictMode: true,

  // ─── TypeScript / ESLint ────────────────────────────────────────
  typescript: {
    tsconfigPath:      './tsconfig.json',
    // @supabase/ssr の GenericSchema 推論ズレを一時許容
    ignoreBuildErrors: true,
  },
  eslint: { dirs: ['app', 'features', 'lib', 'components', 'hooks'], ignoreDuringBuilds: true },

  // ─── 画像ドメイン許可 ─────────────────────────────────────────────
  images: {
    remotePatterns: [
      { protocol: 'https', hostname: '**.supabase.co' },
      { protocol: 'https', hostname: '**.googleusercontent.com' },
    ],
  },

  // ─── セキュリティヘッダー ─────────────────────────────────────────
  async headers() {
    return [
      {
        source: '/(.*)',
        headers: [
          { key: 'X-Frame-Options',           value: 'DENY' },
          { key: 'X-Content-Type-Options',     value: 'nosniff' },
          { key: 'Referrer-Policy',            value: 'strict-origin-when-cross-origin' },
          { key: 'Permissions-Policy',         value: 'camera=(), microphone=(), geolocation=()' },
        ],
      },
    ];
  },
};

export default nextConfig;
